# ===== 环境变量示例 =====
# 本地开发默认使用 SQLite + 本地 Redis（复制本文件为 .env 后按需修改）。
# 生产（Docker Compose）会自动注入 postgres 连接串，无需修改 DATABASE_URL。

# --- 数据库 ---
# 本地（SQLite，免安装）：
ASSISTANT_DATABASE_URL=sqlite:///./data/dev.db
# 生产（PostgreSQL，容器内置 psycopg 驱动；本地裸环境需 pip install "psycopg[binary]"）：
# ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

ASSISTANT_REDIS_URL=redis://localhost:6379/0
ASSISTANT_DATA_DIR=data
ASSISTANT_SOURCES_FILE=sources.yaml

# --- OpenCLI 数据源（type=opencli）---
# opencli 命令路径（如已安装到 PATH 则无需修改）
# ASSISTANT_OPENCLI_BIN=opencli
# 单次 opencli 命令超时秒数
# ASSISTANT_OPENCLI_TIMEOUT_SECONDS=90
# 多 Chrome 配置时指定默认别名（opencli profile list 查看）
# ASSISTANT_OPENCLI_PROFILE=9hrejvdm
# web 源静态抓不到内容时是否自动用 OpenCLI 浏览器渲染兜底（支持 JS 页面）
# ASSISTANT_OPENCLI_RENDER_FALLBACK=true
# 渲染抓取单次超时秒数
# ASSISTANT_OPENCLI_RENDER_TIMEOUT_SECONDS=150

# --- LLM（留空则使用本地抽取式摘要 + 模板文案的降级方案）---
ASSISTANT_LLM_API_KEY=sk-your-api-key
ASSISTANT_LLM_BASE_URL=https://api.deepseek.com/v1
ASSISTANT_LLM_MODEL=deepseek-chat

ASSISTANT_PLATFORMS_FILE=platforms.yaml
# ASSISTANT_SENSITIVE_WORDS_FILE=data/sensitive_words.txt
# ASSISTANT_AD_WORDS_FILE=data/ad_words.txt

# --- REST API 鉴权（SEC-01 基线）---
# 配置后所有 /api/* 请求须携带请求头 X-API-Token: <token>（/api/health 除外）。
# 留空表示本地开发模式不校验。
# ASSISTANT_API_TOKEN=change-me

# --- 前端构建时可选的 API Token 注入（web-ui/.env）---
# VITE_API_TOKEN=change-me
